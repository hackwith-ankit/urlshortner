{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "BACKEND_URL_PLACEHOLDER/api/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "BACKEND_URL_PLACEHOLDER/s/:path*"
    },
    {
      "source": "/((?!api|s|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
